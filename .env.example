# Copy this file to .env in the project root before running the backend.

# Server
PORT=4000

# Chain mode: "local" needs zero setup and is perfect for a demo.
# Set to "onchain" once you've deployed contracts/AuditRegistry.sol
# to a testnet, to anchor real transactions instead.
CHAIN_MODE=local

# --- Only required when CHAIN_MODE=onchain ---
# RPC endpoint from Alchemy / Infura / a public testnet RPC
RPC_URL=
# Private key of the wallet paying gas (use a throwaway testnet wallet)
PRIVATE_KEY=
# Address printed by `npm run deploy:sepolia` in /contracts
CONTRACT_ADDRESS=
